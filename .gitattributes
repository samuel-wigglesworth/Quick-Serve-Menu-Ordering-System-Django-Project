# Normalize line endings to LF on commit, checkout as-is on Windows
* text=auto eol=lf

# Force LF for web and Python files
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.py   text eol=lf
*.txt  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
_redirects text eol=lf

# Binary files – no line-ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.whl  binary
*.pyc  binary
